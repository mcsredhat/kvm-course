#cloud-config
hostname: web3
fqdn: web3.lab.local
manage_etc_hosts: true

users:
  - name: devops
    groups: [wheel]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKPZXtSBTYqP/PKb+Rj3oCIOxFXaCotmua0M8RwKIrss assulai@rhel-workstation

write_files:
  - path: /etc/motd
    content: |
      Managed by cloud-init. Do not edit by hand.

runcmd:
  - [ systemctl, enable, --now, chronyd ]
  - [ sh, -c, "echo provisioned > /var/log/provisioned.flag" ]
